# Social World Simulator — Environment Variables Example
# Note: All APIs have fallback local simulation engines if keys are not provided.

# NVIDIA AI Nemotron 70B & Llama 3.3 Multimodal API
NVIDIA_API_KEY=nvapi-xxxx-your-key-here

# ElevenLabs Voice Synthesis API
ELEVENLABS_API_KEY=el-xxxx-your-key-here

# fal.ai FLUX.1 Generative Media API
FAL_KEY=fal-xxxx-your-key-here

# Firecrawl Web Scraping & Trend Crawling API
FIRECRAWL_API_KEY=fc-xxxx-your-key-here
